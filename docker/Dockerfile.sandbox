# Lightweight multi-agent sandbox image for tmux-agent-deck (CCNOW)
# Runs ccnow-agent.js + @botiverse/oar as non-root UID 1000 (matching host ubuntu UID) for clean bind mounts.
# Node.js >= 24 is required by @botiverse/oar (>=0.128.1).
FROM node:24-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    TERM=xterm-256color \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    openssh-client \
    procps \
    ripgrep \
    tmux \
    && rm -rf /var/lib/apt/lists/*

# Ensure workspace and ccnow agent mount directories exist and belong to UID 1000 (node)
RUN mkdir -p /workspace /opt/ccnow /home/node/.ccnow \
    && chown -R node:node /workspace /opt/ccnow /home/node

# Pre-install lightweight @botiverse/oar (omit optional heavy SDKs to stay well within sandbox memory quota)
WORKDIR /opt/ccnow
RUN npm init -y >/dev/null 2>&1 \
    && npm install --omit=optional --no-audit --no-fund @botiverse/oar@^0.128.1 \
    && chown -R node:node /opt/ccnow

# Fallback copy of ccnow-agent.js & oar-runtime.js (at runtime host scripts are bind-mounted read-only)
COPY client/ccnow-agent.js /opt/ccnow/ccnow-agent.js
COPY client/oar-runtime.js /opt/ccnow/oar-runtime.js

USER node
WORKDIR /workspace

ENV HOME=/home/node \
    NODE_PATH=/opt/ccnow/node_modules \
    CCNOW_CONFIG_DIR=/home/node/.ccnow \
    CCNOW_DEFAULT_WORKSPACE=/workspace \
    CCNOW_DEFAULT_WORKSPACE_NAME=workspace

CMD ["node", "/opt/ccnow/ccnow-agent.js", "start"]
